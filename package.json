{
  "name": "bharat-bazaar-ecommerce",
  "version": "2.0.0",
  "description": "Premium Indian E-Commerce Store with Cart, Wishlist, Multi-Step Checkout, Indian Payments & Real-Time Tracking",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm start --prefix ecommerce-app",
    "build": "npm run build --prefix ecommerce-app",
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"yellow.bold,cyan.bold\" \"npm run server\" \"npm run client\"",
    "generate-data": "node scripts/generateRealCatalog.js",
    "seed": "node seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^2.0.20"
  }
}
